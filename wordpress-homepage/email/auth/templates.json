[{"id": "magic", "where": "Magic link", "subject": "Your sign-in link for Jay's AI Playbook", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Here's your sign-in link</title></head>\n<body style=\"margin:0;padding:0;background:#F3F5F9\">\n<div style=\"display:none;max-height:0;overflow:hidden\">Tap the button to sign in. No password needed.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3F5F9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 20px\"><img src=\"https://jaysaiplaybook.blog/wp-content/uploads/2026/10/email-logo.png\" alt=\"Jay's AI Playbook\" width=\"170\" style=\"display:block;border:0;height:auto\"></td></tr>\n<tr><td style=\"background:#FFFFFF;border:1px solid #DCE1EC;border-radius:16px;padding:32px 28px\">\n<h1 style=\"margin:0 0 16px;font:700 24px/1.25 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Here's your sign-in link</h1>\n<p style=\"margin:0 0 16px;font:16px/1.55 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Hi there,</p><p style=\"margin:0 0 16px;font:16px/1.55 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Tap the button below to sign in to your members area. There's no password to remember.</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 22px\"><tr><td style=\"background:#2B44E6;border-radius:999px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 26px;font:700 16px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#FFFFFF;text-decoration:none\">Sign in to my members area</a></td></tr></table>\n<p style=\"margin:0 0 12px;font:14px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">The link works once and runs out after an hour. If it's expired, just ask for a new one on the sign-in page.</p>\n<p style=\"margin:0;font:14px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">Didn't ask for this? You can safely ignore this email. Nothing will change.</p>\n</td></tr>\n<tr><td style=\"padding:20px 4px 0;font:13px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">Jay's AI Playbook \u00b7 <a href=\"https://jaysaiplaybook.blog\" style=\"color:#55607A\">jaysaiplaybook.blog</a><br>Questions? Just reply to this email, it comes straight to me.</td></tr>\n</table></td></tr></table></body></html>"}, {"id": "confirm", "where": "Confirm signup", "subject": "Welcome to Jay's AI Playbook: confirm your email", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Welcome! One tap and you're in</title></head>\n<body style=\"margin:0;padding:0;background:#F3F5F9\">\n<div style=\"display:none;max-height:0;overflow:hidden\">One tap and your free members area is ready.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3F5F9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 20px\"><img src=\"https://jaysaiplaybook.blog/wp-content/uploads/2026/10/email-logo.png\" alt=\"Jay's AI Playbook\" width=\"170\" style=\"display:block;border:0;height:auto\"></td></tr>\n<tr><td style=\"background:#FFFFFF;border:1px solid #DCE1EC;border-radius:16px;padding:32px 28px\">\n<h1 style=\"margin:0 0 16px;font:700 24px/1.25 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Welcome! One tap and you're in</h1>\n<p style=\"margin:0 0 16px;font:16px/1.55 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Hi there,</p><p style=\"margin:0 0 16px;font:16px/1.55 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Thanks for joining Jay's AI Playbook. Tap the button below to confirm your email and open your free members area, with your own 90-day AI plan and every free prompt in one place.</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 22px\"><tr><td style=\"background:#2B44E6;border-radius:999px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 26px;font:700 16px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#FFFFFF;text-decoration:none\">Confirm and open my members area</a></td></tr></table>\n<p style=\"margin:0 0 12px;font:14px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">The link works once and runs out after an hour. If it's expired, just ask for a new one on the sign-in page.</p>\n<p style=\"margin:0;font:14px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">Didn't ask for this? You can safely ignore this email. Nothing will change.</p>\n</td></tr>\n<tr><td style=\"padding:20px 4px 0;font:13px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">Jay's AI Playbook \u00b7 <a href=\"https://jaysaiplaybook.blog\" style=\"color:#55607A\">jaysaiplaybook.blog</a><br>Questions? Just reply to this email, it comes straight to me.</td></tr>\n</table></td></tr></table></body></html>"}, {"id": "change", "where": "Change email address", "subject": "Confirm your new email address", "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Confirm your new email address</title></head>\n<body style=\"margin:0;padding:0;background:#F3F5F9\">\n<div style=\"display:none;max-height:0;overflow:hidden\">Confirm the new email for your members area.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F3F5F9\"><tr><td align=\"center\" style=\"padding:32px 16px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px\">\n<tr><td style=\"padding:0 4px 20px\"><img src=\"https://jaysaiplaybook.blog/wp-content/uploads/2026/10/email-logo.png\" alt=\"Jay's AI Playbook\" width=\"170\" style=\"display:block;border:0;height:auto\"></td></tr>\n<tr><td style=\"background:#FFFFFF;border:1px solid #DCE1EC;border-radius:16px;padding:32px 28px\">\n<h1 style=\"margin:0 0 16px;font:700 24px/1.25 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Confirm your new email address</h1>\n<p style=\"margin:0 0 16px;font:16px/1.55 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">Hi there,</p><p style=\"margin:0 0 16px;font:16px/1.55 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#0E1433\">You asked to change the email address on your Jay's AI Playbook members area. Tap the button below to confirm it.</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:8px 0 22px\"><tr><td style=\"background:#2B44E6;border-radius:999px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:14px 26px;font:700 16px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#FFFFFF;text-decoration:none\">Confirm my new email</a></td></tr></table>\n<p style=\"margin:0 0 12px;font:14px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">If you didn't ask for this change, reply to this email and I'll look into it straight away.</p>\n<p style=\"margin:0;font:14px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">Didn't ask for this? You can safely ignore this email. Nothing will change.</p>\n</td></tr>\n<tr><td style=\"padding:20px 4px 0;font:13px/1.5 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#55607A\">Jay's AI Playbook \u00b7 <a href=\"https://jaysaiplaybook.blog\" style=\"color:#55607A\">jaysaiplaybook.blog</a><br>Questions? Just reply to this email, it comes straight to me.</td></tr>\n</table></td></tr></table></body></html>"}]